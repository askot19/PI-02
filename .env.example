# Copie este arquivo para .env e ajuste os valores.
# O .env é carregado automaticamente pelo settings.py (python-dotenv) e
# nunca deve ser commitado (já está no .gitignore).

DJANGO_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE: postgresql (padrão) | sqlite | mysql
DB_ENGINE=postgresql
DB_NAME=viva_cafe
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
